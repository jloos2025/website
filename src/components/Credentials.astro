---
import { business } from '../data/business';
---

<section class="creds section" aria-labelledby="creds-h">
  <div class="wrap">
    <span class="eyebrow">Credentials</span>
    <h2 id="creds-h">The certifications behind the work.</h2>

    <div class="cred-feature">
      <p class="cred-flag">Xcel Energy rebate partner</p>
      <p>
        Heat pump rebates through Xcel Energy can take real money off the cost of a new system, and
        the paperwork is where most homeowners give up. We are a participating contractor, so we
        handle that side for you and make sure the equipment we quote actually qualifies before you
        buy it.
      </p>
      <p class="cred-note">
        The air source heat pump rebate is a closed program, so it only pays out when an approved
        contractor does the work. <a href="/xcel-energy-heat-pump-rebates/">How the rebates work</a>.
      </p>
    </div>

    <ul class="cred-list">
      {
        business.credentials
          .filter((c) => !c.name.startsWith('Xcel'))
          .map((c) => (
            <li>
              <strong>{c.name}</strong>
              <span>{c.detail}</span>
            </li>
          ))
      }
    </ul>
  </div>
</section>
