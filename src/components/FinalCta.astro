---
import PhoneIcon from './PhoneIcon.astro';
import { business } from '../data/business';
---

<section class="final-cta section" aria-labelledby="cta-h">
  <div class="wrap">
    <span class="eyebrow">No heat? No cool? No hot water?</span>
    <h2 id="cta-h">Call the shop. A Loos will pick up.</h2>
    <p>
      Tell us what the system is doing — or not doing — and we'll tell you the next step, even if
      it's one you can do yourself for free.
    </p>
    <a class="call-btn" href={`tel:${business.phoneE164}`}>
      <PhoneIcon />
      Call {business.phoneDisplay}
    </a>
    <p class="call-note">{business.hoursShort} · {business.afterHoursLine}</p>
  </div>
</section>
