---
import PhoneIcon from './PhoneIcon.astro';
import { business } from '../data/business';
---

<header class="site-header">
  <div class="wrap">
    <a class="brand-link" href="/">
      <span class="brand">
        <span class="name">{business.name}</span>
        <span class="place">{business.place}</span>
      </span>
    </a>
    <nav class="site-nav" aria-label="Main">
      <a href="/emergency/">Emergency</a>
      <a href="/gallery/">Our work</a>
      <a href="/about/">About</a>
      <a href="/blog/">Advice</a>
    </nav>
    <div class="header-call">
      <a
        class="book-btn"
        href="https://book.housecallpro.com/book/Loos--Sons-HVAC-LLC/78dd88b83ddc4ec284ac1c3ef296ad07?v2=true"
        aria-label="Book an appointment online with Loos and Sons"
      >
        Book online
      </a>
      <a
        class="call-btn"
        href={`tel:${business.phoneE164}`}
        aria-label={`Call Loos and Sons at ${business.phoneDisplay}`}
      >
        <PhoneIcon />
        <span class="num">{business.phoneDisplay}</span>
      </a>
    </div>
  </div>
</header>
