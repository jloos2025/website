---
import PhoneIcon from './PhoneIcon.astro';
import { business } from '../data/business';
---

<header class="site-header">
  <div class="wrap">
    <a class="brand-link" href="/">
      <img class="logo-img" src="/logo.png" width="72" height="72" alt="Loos & Sons HVAC logo" />
      <span class="brand">
        <span class="name">{business.name}</span>
        <span class="place">{business.place}</span>
      </span>
    </a>
    <nav class="site-nav" aria-label="Main">
      <a href="/emergency/">Emergency</a>
      <a href="/gallery/">Our work</a>
      <a href="/about/">About</a>
      <a href="/blog/">Advice</a>
    </nav>
    <div class="header-call">
      <p class="hours">Call now</p>
      <a
        class="call-btn"
        href={`tel:${business.phoneE164}`}
        aria-label={`Call Loos and Sons at ${business.phoneDisplay}`}
      >
        <PhoneIcon />
        <span class="num">{business.phoneDisplay}</span>
      </a>
    </div>
  </div>
</header>
