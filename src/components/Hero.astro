---
import { Image } from 'astro:assets';
import PhoneIcon from './PhoneIcon.astro';
import scenery from '../assets/hero-scenery.jpg';
import logo from '../assets/hero-logo.png';
import { business } from '../data/business';
---

<section class="hero" aria-labelledby="hero-h">
  <div class="hero-bg" aria-hidden="true">
    <Image src={scenery} alt="" widths={[900, 1600]} sizes="100vw" loading="eager" />
  </div>
  <div class="wrap">
    <div class="hero-copy">
      <span class="eyebrow">Family owned and operated in Longmont, Colorado</span>
      <h1 id="hero-h">Heating and air conditioning in Longmont and across the Front Range.</h1>
      <p class="lede">
        New systems, full replacements, new construction, and the service calls in between. We
        install and work on furnaces, air conditioning, heat pumps, boilers, radiant heat,
        geothermal, and water heaters. Call the shop and a person picks up, then a technician
        actually shows up when we said we would.
      </p>
      <a class="call-btn" href={`tel:${business.phoneE164}`}>
        <PhoneIcon />
        Call {business.phoneDisplay}
      </a>
      <p class="call-note">We can usually get out the same day.</p>
    </div>
    <div class="hero-logo">
      <Image
        src={logo}
        alt={`${business.fullName} logo`}
        widths={[320, 640]}
        sizes="(min-width: 880px) 30vw, 40vw"
        loading="eager"
      />
    </div>
  </div>
</section>
