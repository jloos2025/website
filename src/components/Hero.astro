---
import { Image } from 'astro:assets';
import PhoneIcon from './PhoneIcon.astro';
import banner from '../assets/hero-banner.png';
import { business } from '../data/business';
---

<section class="hero" aria-labelledby="hero-h">
  <div class="hero-bg" aria-hidden="true">
    <Image src={banner} alt="" widths={[900, 1600]} sizes="100vw" loading="eager" />
  </div>
  <div class="wrap">
    <div class="hero-copy">
      <span class="eyebrow">Family owned and operated in Longmont, Colorado</span>
      <h1 id="hero-h">Heating and air conditioning repair in Longmont, Colorado.</h1>
      <p class="lede">
        Furnace out in January? AC dead in an August heat wave? Call the shop and a real person
        picks up, then a real technician shows up. Furnaces, air conditioning, mini-splits, and
        water heaters across the Front Range.
      </p>
      <a class="call-btn" href={`tel:${business.phoneE164}`}>
        <PhoneIcon />
        Call {business.phoneDisplay}
      </a>
      <p class="call-note">Same-day service most days. We answer the phone.</p>
    </div>
  </div>
</section>
