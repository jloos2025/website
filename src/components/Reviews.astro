---
import { business } from '../data/business';
---

<section class="reviews section" aria-labelledby="rev-h">
  <div class="wrap">
    <span class="eyebrow">From the neighbors</span>
    <h2 id="rev-h">The reviews sound like the town talking.</h2>
    <div class="rev-grid">
      {
        business.reviews.map((r) => (
          <article class="rev">
            <p class="stars" aria-label="5 out of 5 stars">
              ★★★★★
            </p>
            <blockquote>{r.quote}</blockquote>
            <cite>
              <b>{r.name}</b>
              {r.detail}
            </cite>
          </article>
        ))
      }
    </div>
  </div>
</section>
