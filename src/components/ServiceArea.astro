---
import { business } from '../data/business';
---

<section class="area section" aria-labelledby="area-h">
  <div class="wrap">
    <span class="eyebrow">Where we drive</span>
    <h2 id="area-h">Based in Longmont. At your door across the Front Range.</h2>
    <p class="area-lede">
      The shop sits in Longmont and we cover the Front Range from there. If you are in one of these
      towns, you are in our neighborhood.
    </p>
    <ul class="towns">
      {business.towns.map((t) => <li class={t === business.city ? 'home' : undefined}>{t}</li>)}
    </ul>
  </div>
</section>
