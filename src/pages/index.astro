---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import WhyUs from '../components/WhyUs.astro';
import ServiceArea from '../components/ServiceArea.astro';
import Reviews from '../components/Reviews.astro';
import FinalCta from '../components/FinalCta.astro';
import { business } from '../data/business';
---

<Base
  title={`${business.fullName} — Furnace & AC Repair in Longmont, CO`}
  description={`Family-run HVAC repair and installation in Longmont, Colorado since ${business.foundingYear}. AC repair, furnace repair, water heaters, and seasonal tune-ups. Call ${business.phoneDisplay}.`}
>
  <Hero />
  <Services />
  <WhyUs />
  <ServiceArea />
  <Reviews />
  <FinalCta />
</Base>
